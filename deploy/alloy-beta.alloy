// 베타 EC2 관측: 메트릭 → Prometheus remote_write, 로그 → Loki push
// 환경변수(observe.env): PROMETHEUS_URL, LOKI_URL, HOST_NAME

prometheus.remote_write "monitoring" {
  endpoint {
    url = sys.env("PROMETHEUS_URL")
  }
}

loki.write "monitoring" {
  endpoint {
    url = sys.env("LOKI_URL")
  }
}

// 모든 메트릭에 host 라벨 (대시보드·시스템 알림의 서버 구분)
prometheus.relabel "add_host" {
  forward_to = [prometheus.remote_write.monitoring.receiver]
  rule {
    target_label = "host"
    replacement  = sys.env("HOST_NAME")
  }
}

// 앱 /metrics (내부망 직접 조회, 공개 프록시는 404)
prometheus.scrape "app" {
  targets         = [{"__address__" = "app:8000"}]
  job_name        = "beta-app"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.add_host.receiver]
}

// 호스트 지표 (디스크·메모리·노드 끊김 알림용)
prometheus.scrape "node" {
  targets    = [{"__address__" = "node-exporter:9100"}]
  job_name   = "beta-node"
  forward_to = [prometheus.relabel.add_host.receiver]
}

// 합성 확인: 트래픽과 무관하게 60초마다 /ready 호출(DB·Redis·Neo4j·GPU 연결 검사, 추천 생성은 안 함)
prometheus.exporter.blackbox "ready" {
  config = "{ modules: { http_ready: { prober: http, timeout: 10s, http: { valid_status_codes: [200] } } } }"

  target {
    name    = "ready"
    address = "http://app:8000/ready"
    module  = "http_ready"
  }
}

// exporter 기본 job(integrations/blackbox/ready)·instance(컨테이너 ID)를 알아보기 쉽게
discovery.relabel "ready" {
  targets = prometheus.exporter.blackbox.ready.targets
  rule {
    target_label = "job"
    replacement  = "beta-probe"
  }
  rule {
    target_label = "instance"
    replacement  = "app:8000/ready"
  }
}

prometheus.scrape "ready" {
  targets         = discovery.relabel.ready.output
  job_name        = "beta-probe"
  scrape_interval = "60s"
  scrape_timeout  = "15s"
  forward_to      = [prometheus.relabel.add_host.receiver]
}

// 컨테이너 로그: 이 compose 프로젝트의 app·caddy·redis만
discovery.docker "beta" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "beta" {
  targets = discovery.docker.beta.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = sys.env("COMPOSE_PROJECT")
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "app|caddy|redis"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

// 라벨은 job/host/service(+graph_query의 func)만 (trace_id·level 등은 LogQL json 필터로)
loki.source.docker "beta" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.beta.output
  labels     = {job = "beta-app", host = sys.env("HOST_NAME")}
  forward_to = [loki.process.beta.receiver]
}

// Neo4j 쿼리 로그(event=graph_query)의 함수명을 func 라벨로 (neo4j 대시보드용, 값 종류 적음)
loki.process "beta" {
  stage.regex {
    expression = `event=graph_query func=(?P<func>[^\s"]+)`
  }
  stage.labels {
    values = {func = ""}
  }
  forward_to = [loki.write.monitoring.receiver]
}
